# Asistente de diseño (Claude). Solo del lado del servidor: nunca con prefijo VITE_.
ANTHROPIC_API_KEY=
# Opcional. Modelo para las sugerencias de diseño.
AI_MODEL=claude-sonnet-5

# Botón "Generar imagen" del Custom Lab. Si faltan, /api/mockup responde 501 y el botón no se muestra.
# IMAGE_PROVIDER: gemini (Google AI Studio) u openai.
IMAGE_PROVIDER=
IMAGE_API_KEY=
# Opcional. Default: gemini-3.1-flash-image (gemini) o gpt-image-2 (openai).
IMAGE_MODEL=

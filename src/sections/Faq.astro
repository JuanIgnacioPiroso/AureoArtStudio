---
import JsonLd from '../components/seo/JsonLd.astro'
import { faqSchema } from '../config/seo'
import { FAQ, type Faq } from '../content/site'

interface Props {
  /** Preguntas de la sección; por defecto, las de la home. */
  items?: readonly Faq[]
}

const { items = FAQ } = Astro.props
const answered = items.filter((f) => f.a)
---

<section id="preguntas" class="section tone" data-tone="light" aria-labelledby="faq-title">
  <div class="wrap faq">
    <h2 id="faq-title" class="section-title">Preguntas frecuentes</h2>
    <div class="faq__list">
      {
        answered.map((f) => (
          <details class="faq__item">
            <summary>{f.q}</summary>
            <p>
              {f.a}
              {f.link && (
                <>
                  {' '}
                  <a class="text-link" href={f.link.href}>
                    {f.link.label}
                  </a>
                </>
              )}
            </p>
          </details>
        ))
      }
    </div>
  </div>
  <JsonLd data={faqSchema(items)} />
</section>

---
import { CATEGORIES } from '../content/site'
import { labProductHref } from '../lab/intent'
import Picture from '../components/Picture.astro'

const items = CATEGORIES.filter((c) => c.enabled)
---

<section id="productos" class="section tone" data-tone="light" aria-labelledby="productos-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="productos-title" class="section-title">Qué personalizamos</h2>
      <p class="lede">Objetos para regalar, para usar todos los días o para representar a tu marca.</p>
    </div>
    <ul class="categories">
      {
        items.map((c) => (
          <li class="category">
            <Picture image={c.image} sizes="(min-width: 901px) 25vw, 50vw" />
            <div class="category__text">
              <h3 class="category__name display">
                {/* El destino va en aria-label y no en el texto: Google lee el <h3>, el lector de pantalla el enlace. */}
                {c.labProductId ? (
                  <a
                    class="category__link"
                    href={labProductHref(c.labProductId)}
                    aria-label={`${c.name}, diseñarlo en el Custom Lab`}
                  >
                    {c.name}
                  </a>
                ) : (
                  <a class="category__link" href="#contacto" aria-label={`${c.name}, consultar por este producto`}>
                    {c.name}
                  </a>
                )}
              </h3>
              <p>{c.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

---
import { CATEGORIES } from '../content/site'
import { labProductHref } from '../lab/intent'
import Picture from '../components/Picture.astro'

const items = CATEGORIES.filter((c) => c.enabled)
---

<section id="productos" class="section tone" data-tone="light" aria-labelledby="productos-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="productos-title" class="section-title">Qué personalizamos</h2>
      <p class="lede">Objetos para regalar, para usar todos los días o para representar a tu marca.</p>
    </div>
    <ul class="categories">
      {
        items.map((c, i) => (
          <li class:list={['category', { 'category--lead': i === 0 }]}>
            <Picture image={c.image} sizes={i === 0 ? '(min-width: 900px) 60vw, 100vw' : '(min-width: 900px) 30vw, 100vw'} />
            <div class="category__text">
              <h3 class="category__name display">{c.name}</h3>
              <p>{c.description}</p>
              {c.labProductId ? (
                <a class="text-link" href={labProductHref(c.labProductId)}>
                  Diseñarlo en el <span translate="no">Custom Lab</span>
                </a>
              ) : (
                <a class="text-link" href="#contacto">
                  Consultar por este producto
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

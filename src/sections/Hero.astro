---
import { LAB_PATH } from '../lab/intent'

/**
 * Hero: titular editorial y una vista real del Custom Lab. La línea dorada se "traza" una vez
 * sobre el grabado, como el paso del láser. El otro movimiento automático de la página es el carrusel
 * de logos de «Confían en nosotros» (TrustedBy.astro).
 */
---

<section id="inicio" class="hero tone" data-tone="dark" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="hero__eyebrow">Objetos únicos.</p>
      <h1 id="hero-title" class="hero__title display">Grabados láser personalizados que dejan huella.</h1>
      <p class="lede">
        Grabamos a láser cuchillos, tablas, mates, copas y cuero con tu nombre, una fecha o tu logo. Diseñalo en nuestro
        simulador 3D, miralo sobre el objeto y pedí tu presupuesto.
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href={LAB_PATH}>Crear mi grabado</a>
        <a class="button" href="#galeria">Explorar trabajos</a>
      </div>
    </div>
    <figure class="hero__figure">
      <div class="hero__media">
        <img
          src="/img/hero-lab.webp"
          width="1600"
          height="1000"
          alt="Cuchillo con mango de madera oscura y el nombre «Martín» grabado en la hoja, en la vista 3D del Custom Lab"
          fetchpriority="high"
        />
        <svg class="hero__trace" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <path class="hero__trace-line" d="M 990 530 L 1150 770 L 1480 770"></path>
          <circle class="hero__trace-dot" cx="990" cy="530" r="7"></circle>
        </svg>
      </div>
      <figcaption class="hero__caption">
        <span class="hero__caption-text">«Martín», grabado en la hoja.</span>
        <span class="note">Vista del Custom Lab, el simulador 3D de esta página.</span>
      </figcaption>
    </figure>
  </div>
</section>

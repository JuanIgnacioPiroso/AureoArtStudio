---
import Picture from '../components/Picture.astro'
import { IMAGES } from '../content/site'
import { LAB_PATH } from '../lab/intent'

/**
 * Hero: titular editorial y un collage fijo de cuatro trabajos del taller, sin enlaces («Explorar trabajos» ya lleva a
 * la galería). Cargan sin lazy porque se ven al abrir la página.
 */
const COLLAGE = [IMAGES.termo, IMAGES.copas, IMAGES.perro, IMAGES.embajada]
---

<section id="inicio" class="hero tone" data-tone="dark" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="hero__eyebrow">Objetos únicos.</p>
      <h1 id="hero-title" class="hero__title display">Grabados láser personalizados que dejan huella.</h1>
      <p class="lede">
        Grabamos a láser cuchillos, tablas, mates, copas y cuero con tu nombre, una fecha o tu logo. Diseñalo en nuestro
        simulador 3D, miralo sobre el objeto y pedí tu presupuesto.
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href={LAB_PATH}>Crear mi grabado</a>
        <a class="button" href="#galeria">Explorar trabajos</a>
      </div>
    </div>
    <figure class="hero__figure">
      <div class="hero__media hero__collage">
        {
          COLLAGE.map((image, i) => (
            <Picture
              image={image}
              sizes="(min-width: 901px) 31vw, 50vw"
              loading="eager"
              fetchpriority={i === 0 ? 'high' : undefined}
            />
          ))
        }
      </div>
      <figcaption class="hero__caption">
        <span class="hero__caption-text">Trabajos hechos en nuestro taller.</span>
      </figcaption>
    </figure>
  </div>
</section>

---
import { getImage } from 'astro:assets'
import { CORPORATE_PATH } from '../content/corporate'
import { TRUSTED_LOGOS } from '../content/logos'
import { CATEGORIES } from '../content/site'
import { WORKS } from '../content/works'

/**
 * Franja de logos de quienes confían en AUREO. Sin logos en src/assets/logos/ no se renderiza.
 * Grilla quieta: cada logo una sola vez, centrado y saltando de línea cuando no entra, con una bajada
 * que dice qué tienen en común. Sin movimiento automático.
 * La home suma el enlace a la página de empresas; esa página lo apaga con `corporateLink={false}`.
 * Las <img> se escriben a mano (con getImage para los raster) porque Astro imprime un alt="" dinámico
 * como `alt` sin valor, y los validadores lo marcan como falta de alt.
 */

interface Props {
  /** Muestra el enlace «Pedidos para empresas». false en la página de empresas, que ya es ese destino. */
  corporateLink?: boolean
}

const { corporateLink = true } = Astro.props

/**
 * Trabajos institucionales con nombre, debajo de los logos (SPEC 26): cada uno abre su obra en la galería de la home.
 * Los títulos salen de WORKS, así que un id que ya no exista se cae de la lista en lugar de romper.
 */
const CASE_IDS = ['w-embajada-argentina', 'w-marmol-ara-san-juan', 'w-panel-uba', 'w-armada-argentina'] as const
const cases = CASE_IDS.flatMap((id) => WORKS.filter((w) => w.id === id))
const plaques = CATEGORIES.find((c) => c.id === 'placas' && c.enabled)

// SVG directo; raster optimizado a 56 px de alto con 1x y 2x, como hacía <Image>.
interface LogoImg {
  src: string
  srcset?: string
  width: number
  height: number
}

const images = new Map<string, LogoImg>(
  await Promise.all(
    TRUSTED_LOGOS.map(async (logo): Promise<[string, LogoImg]> => {
      if (logo.isSvg) return [logo.file, { src: logo.src.src, width: logo.src.width, height: logo.src.height }]
      const img = await getImage({ src: logo.src, height: 56, densities: [1, 2] })
      return [
        logo.file,
        {
          src: img.src,
          srcset: img.srcSet.attribute,
          width: Number(img.attributes.width),
          height: Number(img.attributes.height),
        },
      ]
    }),
  ),
)
---

{
  TRUSTED_LOGOS.length > 0 && (
    <section id="confian" class="section tone trusted" data-tone="light" aria-labelledby="confian-title">
      <div class="wrap">
        <h2 id="confian-title" class="trusted__title">
          Confían en nosotros
        </h2>
        <p class="trusted__lede">Instituciones públicas, municipios y universidades que nos encargaron placas y reconocimientos.</p>
      </div>
      <div class="wrap">
        <ul class="trusted__logos">
          {TRUSTED_LOGOS.map((logo) => {
            const img = images.get(logo.file)!
            return (
              <li class="trusted__item">
                <img
                  class="trusted__logo"
                  src={img.src}
                  srcset={img.srcset}
                  width={img.width}
                  height={img.height}
                  alt={logo.name}
                  loading="lazy"
                  decoding="async"
                />
              </li>
            )
          })}
        </ul>
      </div>
      {corporateLink && cases.length > 0 && (
        <div class="wrap">
          <ul class="trusted__cases" aria-label="Algunos trabajos institucionales">
            {cases.map((w) => (
              <li>
                <a class="text-link" href={`/?obra=${w.id}#galeria`}>
                  {w.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
      {corporateLink && (
        <p class="wrap trusted__more">
          {plaques && (
            <>
              <a class="text-link" href={`/${plaques.slug}/`}>
                Placas y reconocimientos
              </a>
              <span aria-hidden="true"> · </span>
            </>
          )}
          <a class="text-link" href={CORPORATE_PATH}>
            Pedidos para empresas
          </a>
        </p>
      )}
    </section>
  )
}

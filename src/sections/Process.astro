---
import { PROCESS } from '../content/site'
---

<section id="proceso" class="section tone" data-tone="light" aria-labelledby="proceso-title">
  <div class="wrap process">
    <div class="section-head">
      <h2 id="proceso-title" class="section-title">Cómo trabajamos</h2>
      <p class="lede">De la idea a la pieza grabada, en cinco pasos y con revisión antes de producir.</p>
    </div>
    <ol class="process__steps">
      {
        PROCESS.map((p, i) => (
          <li class="process__step">
            <span class="process__n display" aria-hidden="true">{i + 1}</span>
            <h3 class="process__title">{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

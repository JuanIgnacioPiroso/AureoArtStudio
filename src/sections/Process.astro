---
import { PROCESS, type ProcessStep } from '../content/site'

interface Props {
  /** Pasos; por defecto, los de la home. */
  steps?: readonly ProcessStep[]
  title?: string
  lede?: string
}

const {
  steps = PROCESS,
  title = 'Cómo trabajamos',
  lede = 'De la idea a la pieza grabada, en cinco pasos y con revisión antes de producir.',
} = Astro.props
---

<section id="proceso" class="section tone" data-tone="light" aria-labelledby="proceso-title">
  <div class="wrap process">
    <div class="section-head">
      <h2 id="proceso-title" class="section-title">{title}</h2>
      <p class="lede">{lede}</p>
    </div>
    <ol class="process__steps">
      {
        steps.map((p, i) => (
          <li class="process__step">
            <span class="process__n display" aria-hidden="true">{i + 1}</span>
            <h3 class="process__title">{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

---
import type { ImageAsset } from '../content/site'

interface Props {
  image: ImageAsset
  sizes: string
  class?: string
}

const { image, sizes, class: className } = Astro.props
---

<figure class:list={['picture', className]}>
  <img
    src={image.src}
    srcset={`${image.srcSmall} 800w, ${image.src} 1600w`}
    sizes={sizes}
    width={image.width}
    height={image.height}
    alt={image.alt}
    loading="lazy"
    decoding="async"
  />
  {image.illustrative && <figcaption class="picture__flag">Imagen ilustrativa</figcaption>}
</figure>

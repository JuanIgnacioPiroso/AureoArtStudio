---
import { getImage, Picture } from 'astro:assets'
import { labProductHref } from '../lab/intent'
import { isImageAsset, isOwnPhoto, orderedWorks, type Work, type WorkImage } from '../content/works'

/**
 * Grilla de trabajos con su visor: la usan la galería de la home y las páginas de categoría.
 * Una sola por página: el visor refleja la obra abierta en `?obra=` y la abre al cargar.
 * La galería de la home le avisa el filtro activo con el evento `works:filter` (id en `detail`) sobre `[data-works]`.
 */
interface Props {
  works: readonly Work[]
  /** Trabajos visibles antes de «Ver más». Sin límite si no se pasa. */
  limit?: number
}

/**
 * Las fotos propias (src/assets/works/) salen en webp a 800 y 1600 px: la tarjeta usa la de 800 y el visor pide la
 * de 1600 al abrirse, igual que las ilustrativas con sus dos .webp pregenerados.
 */
const THUMB_WIDTH = 800
const BIG_WIDTH = 1600

interface BigImage {
  src: string
  width: number
  height: number
  alt: string
}

const big = async (img: WorkImage): Promise<BigImage> => {
  const out = await getImage({ src: img.src, width: Math.min(BIG_WIDTH, img.src.width), format: 'webp' })
  return { src: out.src, width: Number(out.attributes.width), height: Number(out.attributes.height), alt: img.alt }
}

const { limit } = Astro.props
const count = (n: number) => (n === 1 ? '1 trabajo' : `${n} trabajos`)

const works = await Promise.all(
  orderedWorks(Astro.props.works).map(async (w) => ({
    ...w,
    big: isImageAsset(w.photo)
      ? { src: w.photo.src, width: w.photo.width, height: w.photo.height, alt: w.photo.alt }
      : await big(w.photo),
    lab: w.labPreview ? await big(w.labPreview) : null,
    illustrative: !isOwnPhoto(w.photo),
  })),
)
---

<div data-works data-limit={limit}>
  <p class="visually-hidden" role="status" data-works-count>{count(works.length)}</p>
  <ul class="works">
    {
      works.map((w) => (
        <li class="work" data-category={w.category} data-work-id={w.id}>
          <button
            type="button"
            class="work__button"
            aria-label={`Ver ${w.title} en grande${w.lab ? ', con vista 3D' : ''}`}
            data-title={w.title}
            data-material={w.material}
            data-detail={w.detail}
            data-src={w.big.src}
            data-width={w.big.width}
            data-height={w.big.height}
            data-alt={w.big.alt}
            data-illustrative={w.illustrative ? 'true' : undefined}
            data-lab-src={w.lab?.src}
            data-lab-width={w.lab?.width}
            data-lab-height={w.lab?.height}
            data-lab-alt={w.lab?.alt}
            data-lab-href={w.labProductId ? labProductHref(w.labProductId) : undefined}
          >
            {isImageAsset(w.photo) ? (
              <img
                src={w.photo.srcSmall}
                width={w.photo.width}
                height={w.photo.height}
                alt={w.photo.alt}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <Picture
                src={w.photo.src}
                alt={w.photo.alt}
                widths={[Math.min(THUMB_WIDTH, w.photo.src.width)]}
                sizes={`${THUMB_WIDTH}px`}
                formats={['webp']}
                fallbackFormat="webp"
                loading="lazy"
                decoding="async"
              />
            )}
            {w.lab && (
              <span class="work__flag" aria-hidden="true">
                Con vista 3D
              </span>
            )}
          </button>
          <div class="work__meta">
            <h3 class="work__title">{w.title}</h3>
            <p class="note">
              {w.material}. {w.detail}
              {w.illustrative && ' Imagen ilustrativa.'}
            </p>
          </div>
        </li>
      ))
    }
  </ul>
  {/* Lo muestra el script: sin JS se ven todos los trabajos y el botón no hace falta. */}
  <div class="works-more" hidden data-works-more>
    <button type="button" class="button button--ghost"></button>
  </div>
  <dialog class="lightbox" aria-labelledby="lightbox-title" data-lightbox>
    <figure hidden>
      <div class="lightbox__shots" data-lightbox-shots>
        <figure class="lightbox__shot">
          <img decoding="async" alt="" />
          <figcaption class="lightbox__label" hidden>Pieza grabada</figcaption>
        </figure>
      </div>
      <figcaption><strong id="lightbox-title"></strong></figcaption>
    </figure>
    <form method="dialog">
      {/* Recorre los trabajos de la grilla (los del filtro activo en la home). Con uno solo, el script la oculta. */}
      <div class="lightbox__nav" data-lightbox-nav>
        <button type="button" class="button" data-lightbox-step="-1">
          <span aria-hidden="true">←</span> Anterior
        </button>
        <button type="button" class="button" data-lightbox-step="1">
          Siguiente <span aria-hidden="true">→</span>
        </button>
      </div>
      <a class="button button--primary lightbox__lab" hidden data-lightbox-lab>Diseñar algo parecido</a>
      <button class="button lightbox__close" type="submit">Cerrar</button>
    </form>
  </dialog>
</div>

<script>
  /**
   * Filtro, «Ver más» y visor de obras. Con `data-limit`, cada filtro muestra sus primeros `limit` trabajos hasta que se
   * toca su «Ver más», y lo recuerda. Las tarjetas se ocultan desde acá para que sin JS se vean todas. El visor refleja
   * la obra abierta (`?obra=`) en la URL, sin sumar entradas al historial, y la abre al cargar.
   */
  const WORK_PARAM = 'obra'
  const ALL = 'todos'

  const root = document.querySelector<HTMLElement>('[data-works]')!
  const items = Array.from(root.querySelectorAll<HTMLLIElement>('[data-work-id]'))
  const status = root.querySelector<HTMLElement>('[data-works-count]')!
  const more = root.querySelector<HTMLElement>('[data-works-more]')!
  const moreButton = more.querySelector('button')!
  const limit = root.dataset.limit ? Number(root.dataset.limit) : Infinity
  const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]')!
  const figure = dialog.querySelector('figure')!
  const shots = figure.querySelector<HTMLElement>('[data-lightbox-shots]')!
  const photoShot = shots.querySelector('figure')!
  const bigImg = photoShot.querySelector('img')!
  const photoLabel = photoShot.querySelector('figcaption')!
  const caption = figure.querySelector(':scope > figcaption')!
  const captionTitle = caption.querySelector('strong')!
  const labLink = dialog.querySelector<HTMLAnchorElement>('[data-lightbox-lab]')!
  const nav = dialog.querySelector<HTMLElement>('[data-lightbox-nav]')!
  const prevButton = nav.querySelector<HTMLButtonElement>('[data-lightbox-step="-1"]')!
  const nextButton = nav.querySelector<HTMLButtonElement>('[data-lightbox-step="1"]')!
  const counter = document.createElement('span')
  counter.className = 'lightbox__count'

  // La galería puede fijar el filtro antes de que corra este script (`data-active-filter`) o después (evento `works:filter`).
  let filter = root.dataset.activeFilter ?? ALL
  /** Filtros cuyo «Ver más» ya se tocó. */
  const expanded = new Set<string>()
  /** Trabajo abierto en el visor, o null. */
  let openItem: HTMLLIElement | null = null
  /** Último trabajo visto en el visor: al cerrar, el foco vuelve a su tarjeta. */
  let lastItem: HTMLLIElement | null = null

  function writeParam(name: string, value: string | null) {
    const url = new URL(window.location.href)
    if (value) url.searchParams.set(name, value)
    else url.searchParams.delete(name)
    history.replaceState(history.state, '', url)
  }

  const inFilter = (li: HTMLLIElement) => filter === ALL || li.dataset.category === filter
  /** Trabajos del filtro activo, en orden: los que recorre el visor, visibles u ocultos por «Ver más». */
  const filtered = () => items.filter(inFilter)

  function render() {
    const list = filtered()
    // El trabajo abierto en el visor nunca queda oculto: si está detrás de «Ver más», la grilla se expande.
    if (openItem && list.indexOf(openItem) >= limit) expanded.add(filter)
    const visibleCount = expanded.has(filter) ? list.length : Math.min(list.length, limit)
    for (const li of items) li.hidden = true
    list.slice(0, visibleCount).forEach((li) => (li.hidden = false))
    const collapsed = list.length - visibleCount
    more.hidden = collapsed === 0
    moreButton.textContent = `Ver más trabajos (${collapsed})`
    status.textContent = visibleCount === 1 ? '1 trabajo' : `${visibleCount} trabajos`
  }

  root.addEventListener('works:filter', (e) => {
    filter = (e as CustomEvent<string>).detail
    render()
  })

  moreButton.addEventListener('click', () => {
    expanded.add(filter)
    render()
    // El botón desaparece: el foco pasa a la primera tarjeta que estaba oculta.
    filtered()[limit]?.querySelector<HTMLButtonElement>('.work__button')?.focus()
  })

  /** Figura de la captura del Custom Lab, junto a la foto. Sólo se arma si el trabajo la tiene. */
  function labShot(d: DOMStringMap): HTMLElement {
    const shot = document.createElement('figure')
    shot.className = 'lightbox__shot'
    shot.dataset.labShot = ''
    const img = document.createElement('img')
    img.decoding = 'async'
    img.src = d.labSrc!
    img.width = Number(d.labWidth)
    img.height = Number(d.labHeight)
    img.alt = d.labAlt!
    const label = document.createElement('figcaption')
    label.className = 'lightbox__label'
    label.textContent = 'Vista en el Custom Lab'
    shot.append(img, label)
    return shot
  }

  function openWork(li: HTMLLIElement) {
    const d = li.querySelector<HTMLButtonElement>('.work__button')!.dataset
    bigImg.src = d.src!
    bigImg.width = Number(d.width)
    bigImg.height = Number(d.height)
    bigImg.alt = d.alt!
    shots.querySelector('[data-lab-shot]')?.remove()
    const withLab = Boolean(d.labSrc)
    if (withLab) shots.prepend(labShot(d))
    shots.toggleAttribute('data-pair', withLab)
    photoLabel.hidden = !withLab
    if (d.labHref) labLink.href = d.labHref
    else labLink.removeAttribute('href')
    labLink.hidden = !d.labHref
    captionTitle.textContent = d.title!
    const text = ` ${d.material}. ${d.detail}${d.illustrative ? ' Imagen ilustrativa.' : ''}`
    figure.hidden = false
    openItem = li
    lastItem = li
    if (li.hidden) render()
    // Contador y flechas sobre los trabajos del filtro activo, incluidos los ocultos por «Ver más». Sin vuelta.
    const list = filtered()
    const index = list.indexOf(li)
    const withNav = list.length > 1 && index >= 0
    nav.hidden = !withNav
    prevButton.disabled = index <= 0
    nextButton.disabled = index >= list.length - 1
    counter.textContent = `${index + 1} de ${list.length}`
    if (withNav) caption.replaceChildren(captionTitle, ' ', counter, text)
    else caption.replaceChildren(captionTitle, text)
    writeParam(WORK_PARAM, li.dataset.workId!)
    if (!dialog.open) dialog.showModal()
    // showModal enfoca el primer botón, que está al pie: el visor arranca desde arriba igual.
    dialog.scrollTop = 0
  }

  for (const li of items) li.querySelector('.work__button')!.addEventListener('click', () => openWork(li))

  /** Pasa al trabajo anterior (-1) o siguiente (1) del filtro activo. En los extremos no hace nada. */
  function step(delta: number) {
    if (!openItem || nav.hidden) return
    const list = filtered()
    const next = list[list.indexOf(openItem) + delta]
    if (!next) return
    openWork(next)
    // Si el botón que tenía el foco quedó deshabilitado (primero o último), el foco pasa al otro.
    const focused = document.activeElement
    if (focused instanceof HTMLButtonElement && focused.disabled) (focused === prevButton ? nextButton : prevButton).focus()
  }

  for (const button of [prevButton, nextButton]) {
    button.addEventListener('click', () => step(Number(button.dataset.lightboxStep)))
  }

  dialog.addEventListener('keydown', (e) => {
    if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return
    if (e.key === 'ArrowLeft') step(-1)
    else if (e.key === 'ArrowRight') step(1)
    else return
    e.preventDefault()
  })

  dialog.addEventListener('close', () => {
    openItem = null
    // El navegador devuelve el foco a la tarjeta que abrió el visor; va a la del último trabajo visto.
    lastItem?.querySelector<HTMLButtonElement>('.work__button')?.focus()
    figure.hidden = true
    bigImg.removeAttribute('src')
    shots.querySelector('[data-lab-shot]')?.remove()
    writeParam(WORK_PARAM, null)
  })
  // Clic en el fondo (fuera del contenido) cierra, como en cualquier visor de imágenes.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close()
  })

  render()

  // Obra abierta desde la URL, aunque esté detrás de «Ver más».
  const initial = items.find((li) => li.dataset.workId === new URLSearchParams(window.location.search).get(WORK_PARAM))
  if (initial) openWork(initial)
</script>

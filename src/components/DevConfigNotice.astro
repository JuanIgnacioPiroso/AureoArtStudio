---
import { business } from '../config/business'

/** Aviso visible sólo en desarrollo: datos comerciales que faltan completar. */
const missing = import.meta.env.DEV
  ? Object.entries(business)
      .filter(([, v]) => v === null)
      .map(([k]) => k)
  : []
const missingSiteUrl = missing.includes('siteUrl')
---

{
  missing.length > 0 && (
    <aside class="dev-notice" role="note">
      Desarrollo: faltan datos en <code>src/config/business.ts</code>: {missing.join(', ')}. Los botones que los usan
      están ocultos.
      {missingSiteUrl && (
        <>
          <br />
          Sin <code>siteUrl</code> no hay URL canónica, sitemap ni imagen de Open Graph con URL absoluta.
        </>
      )}
    </aside>
  )
}

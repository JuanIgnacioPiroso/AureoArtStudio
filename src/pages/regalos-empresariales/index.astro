---
import LabProductCard from '../../components/LabProductCard.astro'
import Picture from '../../components/Picture.astro'
import JsonLd from '../../components/seo/JsonLd.astro'
import { business } from '../../config/business'
import { breadcrumbSchema, serviceSchema } from '../../config/seo'
import { categoryHref, labProducts, type CategoryDestination } from '../../content/categories'
import {
  CORPORATE_FAQ,
  CORPORATE_OCCASIONS,
  CORPORATE_PATH,
  CORPORATE_PRODUCT_IDS,
  CORPORATE_SEO,
  corporateConditions,
  corporateSteps,
} from '../../content/corporate'
import { CATEGORIES, PURCHASE_FAQ } from '../../content/site'
import { labProductHref } from '../../lab/intent'
import { getProduct } from '../../lab/model/catalog'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ContactCta from '../../sections/ContactCta.astro'
import Faq from '../../sections/Faq.astro'
import Process from '../../sections/Process.astro'
import TrustedBy from '../../sections/TrustedBy.astro'

/** Página para empresas y organismos (SPEC 19): decide por condiciones del pedido, no por producto. */

const category = CATEGORIES.find((c) => c.id === 'empresas')!
// El botón principal sigue la regla de la categoría: WhatsApp o email con la consulta de empresas, o el Lab.
const main = categoryHref(category, business)
const MAIN_LABEL: Record<CategoryDestination['kind'], string> = {
  lab: 'Probar mi logo en el Custom Lab',
  whatsapp: 'Pedir presupuesto por WhatsApp',
  email: 'Pedir presupuesto por email',
}

// Catálogo leído en el build: la página no manda el catálogo al navegador.
const products = labProducts(CORPORATE_PRODUCT_IDS)
const occasions = CORPORATE_OCCASIONS.map((o) => ({
  ...o,
  products: o.productIds.map((id) => ({ name: getProduct(id).name, href: labProductHref(id) })),
}))
const steps = corporateSteps()
const STEP_COUNT = ['cero', 'uno', 'dos', 'tres', 'cuatro', 'cinco', 'seis']
const conditions = corporateConditions()
const faq = [...CORPORATE_FAQ, ...PURCHASE_FAQ]
const hasAnswers = faq.some((f) => f.a)
---

<BaseLayout
  page="categoria"
  path={CORPORATE_PATH}
  title={CORPORATE_SEO.title}
  description={CORPORATE_SEO.description}
  ogTitle={CORPORATE_SEO.title}
  ogDescription={CORPORATE_SEO.description}
  ogImage={category.image}
>
  <Fragment slot="jsonld">
    <JsonLd
      data={breadcrumbSchema([
        { name: 'Inicio', path: '/' },
        { name: 'Empresas', path: CORPORATE_PATH },
      ])}
    />
    <JsonLd
      data={serviceSchema(business, {
        path: CORPORATE_PATH,
        name: CORPORATE_SEO.h1,
        serviceType: 'Grabado láser de regalos empresariales',
        description: CORPORATE_SEO.description,
      })}
    />
  </Fragment>
  <section class="section tone category-hero" data-tone="dark" aria-labelledby="empresas-title">
    <div class="wrap category-hero__grid">
      <div>
        <nav class="breadcrumbs" aria-label="Migas de pan">
          <ol>
            <li><a href="/">Inicio</a></li>
            <li aria-current="page">Empresas</li>
          </ol>
        </nav>
        <h1 id="empresas-title" class="category-hero__title display">{CORPORATE_SEO.h1}</h1>
        <p class="lede">{CORPORATE_SEO.intro}</p>
        <div class="hero__actions">
          <a
            class="button button--primary"
            href={main.href}
            target={main.kind === 'whatsapp' ? '_blank' : undefined}
            rel={main.kind === 'whatsapp' ? 'noopener noreferrer' : undefined}
          >
            {MAIN_LABEL[main.kind]}
            {main.kind === 'whatsapp' && <span class="visually-hidden"> (se abre en otra pestaña)</span>}
          </a>
        </div>
      </div>
      <Picture image={category.image} sizes="(min-width: 901px) 40vw, 100vw" class="category-hero__image" />
    </div>
  </section>

  <section class="section tone" data-tone="light" aria-labelledby="ocasiones-title">
    <div class="wrap">
      <h2 id="ocasiones-title" class="section-title corporate__title">Para qué</h2>
      <ul class="corporate-occasions">
        {
          occasions.map((o) => (
            <li class="corporate-occasion">
              <h3 class="corporate-occasion__title display">{o.title}</h3>
              <p>{o.text}</p>
              <p class="corporate-occasion__products">
                <span class="corporate-occasion__label">En el Custom Lab:</span>{' '}
                {o.products.map((p, i) => (
                  <>
                    {i > 0 && ', '}
                    <a class="text-link" href={p.href}>
                      {p.name}
                    </a>
                  </>
                ))}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section tone" data-tone="dark" aria-labelledby="productos-title">
    <div class="wrap">
      <h2 id="productos-title" class="section-title">Productos que más se piden con logo</h2>
      <ul class="lab-products">
        {
          products.map((p) => (
            <LabProductCard
              product={p}
              linkLabel="Probar con tu logo"
              linkAriaLabel={`Probar con tu logo: ${p.name} en el Custom Lab`}
            />
          ))
        }
      </ul>
    </div>
  </section>

  <Process
    steps={steps}
    title="Cómo trabajamos con empresas"
    lede={`De tu logo a la tanda grabada, en ${STEP_COUNT[steps.length]} pasos y con tu aprobación antes de producir.`}
  />

  <section class="section tone" data-tone="dark" aria-label="Pedido y logo">
    <div class:list={['wrap', 'corporate-order', { 'corporate-order--split': conditions.length > 0 }]}>
      {
        conditions.length > 0 && (
          <div>
            <h2 id="datos-title" class="section-title corporate__title">
              Datos del pedido
            </h2>
            <dl class="corporate-conditions">
              {conditions.map((l) => (
                <div>
                  <dt>{l.label}</dt>
                  <dd>{l.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        )
      }
      <div>
        <h2 id="logo-title" class="section-title corporate__title">Formato del logo</h2>
        <ul class="corporate-logo">
          <li>Vector en SVG, PDF, AI o EPS, o un PNG transparente de al menos 1000 px de ancho.</li>
          <li>El láser graba un solo tono: el logo sale en el color que toma el material, sin degradés ni fotos.</li>
        </ul>
      </div>
    </div>
  </section>

  <TrustedBy corporateLink={false} />

  {/* Faq suma el JSON-LD FAQPage con las preguntas respondidas. */}
  {hasAnswers && <Faq items={faq} />}

  <ContactCta />
</BaseLayout>

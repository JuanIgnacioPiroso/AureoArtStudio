---
import { Font, getImage } from 'astro:assets'
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/landing.css'
import DevConfigNotice from '../components/DevConfigNotice.astro'
import Footer from '../components/layout/Footer.astro'
import Header from '../components/layout/Header.astro'
import { absoluteUrl, OG_IMAGE } from '../config/seo'
import { isIllustrative, type SiteImage } from '../content/site'
import { FONTS } from '../lab/model/catalog'

interface Props {
  page: 'home' | 'lab' | 'materiales' | 'categoria' | '404'
  /** Ruta canónica de la página, sin query string (`/custom-lab/?d=…` declara `/custom-lab/`). */
  path: '/' | `/${string}/`
  title: string
  description: string
  ogTitle: string
  ogDescription: string
  /** Foto propia para compartir la página; sin ella (o con una ilustrativa) va la OG general. */
  ogImage?: SiteImage
  /** Páginas que no van al índice (la 404). */
  noindex?: boolean
}

const { page, path, title, description, ogTitle, ogDescription, ogImage: ogPhoto, noindex = false } = Astro.props

// Sin `business.siteUrl` no hay URL absoluta: se omiten canonical y og:url, y og:image queda relativa.
// La 404 (noindex) no declara canonical: se sirve en cualquier URL rota.
const canonicalUrl = noindex ? null : absoluteUrl(path)
// La foto propia se recorta a 1,91:1, la proporción de la vista grande de WhatsApp, Facebook y X: 1200 × 630, o
// más chica si la foto es más angosta (astro:assets no agranda). Las verticales perderían el grabado en el recorte:
// esas páginas comparten la OG general.
const ownOg = ogPhoto && !isIllustrative(ogPhoto) && ogPhoto.src.width >= ogPhoto.src.height ? ogPhoto : null
const ogWidth = ownOg ? Math.min(OG_IMAGE.width, ownOg.src.width) : 0
const og =
  ownOg
    ? await getImage({
        src: ownOg.src,
        width: ogWidth,
        height: Math.round((ogWidth * OG_IMAGE.height) / OG_IMAGE.width),
        fit: 'cover',
        // `position` de la foto es CSS (`center 35%`) y sharp no lo entiende: recorta donde está el detalle.
        position: 'attention',
        format: 'jpg',
      }).then((img) => ({
        path: img.src,
        width: Number(img.attributes.width),
        height: Number(img.attributes.height),
        alt: ownOg.alt,
      }))
    : OG_IMAGE
const ogImage = absoluteUrl(og.path) ?? og.path

// Las 17 de grabado sólo en el Lab y sin preload: `ensureFonts` (lab/model/measure.ts) las pide al usarlas.
const labFonts = page === 'lab' ? Object.values(FONTS).filter((f) => f.id !== 'bodoni' && f.id !== 'grotesk') : []
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <slot name="head" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#16171A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="AUREO Art Studio" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <Font cssVariable="--font-bodoni" preload />
    <Font cssVariable="--font-grotesk" preload />
    {labFonts.map((f) => <Font cssVariable={f.cssVariable} />)}
    <slot name="jsonld" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header page={page} />
    <main id="contenido" class={page === 'lab' ? 'lab-page' : undefined}>
      <slot />
    </main>
    <Footer />
    <DevConfigNotice />
  </body>
</html>
